# Unreal Engine Intermediate and Build Files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
DerivedDataCache/*
Saved/*
Intermediate/*
Binaries/*
Build/
Build/*
!Build/*.Target.cs
!Build/*.Build.cs

# Ignore build config files generated by UE
.vscode/
.vs/
*.VC.db
*.VC.opendb
*.suo
*.user
*.userprefs
*.sln.DotSettings.user

# Ignore backup and autosave files
*.bak
*.tmp
*.temp
*.log
*.vsconfig
*.old
*_BuiltData.uasset
*_BuiltData.uexp

# Ignore plugin intermediates
Plugins/*/Intermediate/
Plugins/*/Binaries/
Plugins/*/Saved/
Plugins/*/DerivedDataCache/

# Keep plugin source
!Plugins/*/Source/

# Ignore Engine intermediates (if you included engine source locally)
Engine/Intermediate/
Engine/Saved/
Engine/DerivedDataCache/
Engine/Binaries/

# Ignore platform-specific builds
*.ipa
*.apk
*.aab
*.app
*.dSYM
*.exe
*.dll
*.lib
*.pdb
*.obj
*.o

# Ignore temporary folders from editors
__pycache__/
*.pyc
*.pyo

# Ignore OS-specific junk
.DS_Store
Thumbs.db
desktop.ini

# Ignore Unreal auto-generated folders
*.GeneratedMeshDistanceField*
*.ShaderCache*
*.ShaderDebug*
*.Cooked
*.BuildId

# Ignore crash reports
*.dmp
*.crash
CrashReportClient/

# Ignore third-party SDK binaries (e.g. EOS)
ThirdParty/*/Bin/
ThirdParty/*/Lib/
ThirdParty/*/Intermediate/

# Ignore IDE project files
.idea/
*.iml
*.xcodeproj/
*.xcworkspace/
*.xcuserstate
*.xcuserdatad

# Keep essential project files
!Config/
!Content/
!Source/
!*.uproject
!*.uplugin
!README*
!*.gitignore
!*.gitattributes
